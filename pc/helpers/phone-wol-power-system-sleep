#!/bin/sh
set -u

CONFIG_FILE="${PHONE_WOL_POWER_ENV:-/etc/phone-wol-power/pc.env}"
WIRED_IFACE="${WIRED_IFACE:-}"
SUSPEND_PRE_DOWN_IFACE="${SUSPEND_PRE_DOWN_IFACE:-}"
SUSPEND_PRE_UNLOAD_MODULES="${SUSPEND_PRE_UNLOAD_MODULES:-}"
SUSPEND_REQUIRE_LOADED_MODULES="${SUSPEND_REQUIRE_LOADED_MODULES:-}"
TAG=phone-wol-power-sleep

config_value() {
  key="$1"
  /usr/bin/sed -n "s/^${key}=//p" "$CONFIG_FILE" 2>/dev/null | /usr/bin/tail -n 1
}

[ -n "$WIRED_IFACE" ] || WIRED_IFACE="$(config_value WIRED_IFACE)"
[ -n "$SUSPEND_PRE_DOWN_IFACE" ] || SUSPEND_PRE_DOWN_IFACE="$(config_value SUSPEND_PRE_DOWN_IFACE)"
[ -n "$SUSPEND_PRE_UNLOAD_MODULES" ] || SUSPEND_PRE_UNLOAD_MODULES="$(config_value SUSPEND_PRE_UNLOAD_MODULES)"
[ -n "$SUSPEND_REQUIRE_LOADED_MODULES" ] || SUSPEND_REQUIRE_LOADED_MODULES="$(config_value SUSPEND_REQUIRE_LOADED_MODULES)"

valid_interface() {
  case "$1" in
    *[!A-Za-z0-9_.:-]*|"") return 1 ;;
    *) return 0 ;;
  esac
}

valid_module() {
  case "$1" in
    *[!A-Za-z0-9_]*|"") return 1 ;;
    *) return 0 ;;
  esac
}

restore_devices() {
  for module in $SUSPEND_PRE_UNLOAD_MODULES; do
    valid_module "$module" || continue
    /sbin/modprobe "$module" 2>/dev/null || true
  done
  if [ -n "$SUSPEND_PRE_DOWN_IFACE" ] && valid_interface "$SUSPEND_PRE_DOWN_IFACE"; then
    /sbin/ip link set "$SUSPEND_PRE_DOWN_IFACE" up 2>/dev/null || true
  fi
}

case "$1/$2" in
  pre/*)
    if ! valid_interface "$WIRED_IFACE"; then
      /usr/bin/logger -t "$TAG" "Invalid or missing WIRED_IFACE; refusing sleep"
      exit 1
    fi

    for module in $SUSPEND_REQUIRE_LOADED_MODULES; do
      if ! valid_module "$module" || ! /sbin/lsmod | /usr/bin/grep -q "^${module}[[:space:]]"; then
        /usr/bin/logger -t "$TAG" "Required module ${module} is not loaded; refusing sleep"
        exit 1
      fi
    done

    /usr/bin/logger -t "$TAG" "Reasserting ${WIRED_IFACE} Wake-on-LAN before sleep"
    /usr/sbin/ethtool -s "$WIRED_IFACE" wol g || exit 1

    if [ -n "$SUSPEND_PRE_DOWN_IFACE" ]; then
      if ! valid_interface "$SUSPEND_PRE_DOWN_IFACE"; then
        /usr/bin/logger -t "$TAG" "Invalid SUSPEND_PRE_DOWN_IFACE; refusing sleep"
        exit 1
      fi
      /usr/bin/logger -t "$TAG" "Taking ${SUSPEND_PRE_DOWN_IFACE} down before sleep"
      /sbin/ip link set "$SUSPEND_PRE_DOWN_IFACE" down 2>/dev/null || true
    fi

    for module in $SUSPEND_PRE_UNLOAD_MODULES; do
      if ! valid_module "$module"; then
        /usr/bin/logger -t "$TAG" "Invalid module in SUSPEND_PRE_UNLOAD_MODULES"
        restore_devices
        exit 1
      fi
      if /sbin/lsmod | /usr/bin/grep -q "^${module}[[:space:]]"; then
        /usr/bin/logger -t "$TAG" "Unloading ${module} before sleep"
        if ! /sbin/modprobe -r "$module"; then
          /usr/bin/logger -t "$TAG" "Failed to unload ${module}"
          restore_devices
          exit 1
        fi
      fi
    done
    ;;
  post/*)
    /usr/bin/logger -t "$TAG" "Restoring configured devices after resume"
    restore_devices
    ;;
esac

exit 0
