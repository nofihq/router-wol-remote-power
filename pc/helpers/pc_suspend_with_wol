#!/bin/sh
set -eu

CONFIG_FILE="${PHONE_WOL_POWER_ENV:-/etc/phone-wol-power/pc.env}"
WIRED_IFACE="${WIRED_IFACE:-}"
SUSPEND_REQUIRE_LOADED_MODULES="${SUSPEND_REQUIRE_LOADED_MODULES:-}"

config_value() {
  key="$1"
  sed -n "s/^${key}=//p" "$CONFIG_FILE" 2>/dev/null | tail -n 1
}

[ -n "$WIRED_IFACE" ] || WIRED_IFACE="$(config_value WIRED_IFACE)"
[ -n "$SUSPEND_REQUIRE_LOADED_MODULES" ] || SUSPEND_REQUIRE_LOADED_MODULES="$(config_value SUSPEND_REQUIRE_LOADED_MODULES)"

if [ -z "$WIRED_IFACE" ]; then
  echo "Set WIRED_IFACE in $CONFIG_FILE or the environment." >&2
  exit 2
fi

case "$WIRED_IFACE" in
  *[!A-Za-z0-9_.:-]*|"")
    echo "Invalid WIRED_IFACE: $WIRED_IFACE" >&2
    exit 2
    ;;
esac

for module in $SUSPEND_REQUIRE_LOADED_MODULES; do
  case "$module" in
    *[!A-Za-z0-9_]*|"")
      echo "Invalid module in SUSPEND_REQUIRE_LOADED_MODULES: $module" >&2
      exit 2
      ;;
  esac
  if ! /sbin/lsmod | /usr/bin/grep -q "^${module}[[:space:]]"; then
    echo "Required suspend module is not loaded: $module" >&2
    /usr/bin/logger -t phone-wol-power "Refusing suspend because required module ${module} is not loaded"
    exit 1
  fi
done

/usr/bin/logger -t phone-wol-power "Reasserting ${WIRED_IFACE} Wake-on-LAN before suspend"
/usr/sbin/ethtool -s "$WIRED_IFACE" wol g

# Driver unload/reload belongs in the systemd pre/post hook. systemctl may
# return before sleep begins, so doing post-resume work here creates a race.
exec /usr/bin/systemctl suspend
